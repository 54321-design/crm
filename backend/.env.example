PORT=5000
API_URL=http://localhost:5000
CORS_ORIGIN=http://localhost:5173

DATABASE_HOST=localhost
DATABASE_PORT=3306
DATABASE_NAME=crm
DATABASE_USER=root
DATABASE_PASSWORD=change_me

JWT_SECRET=change_this_to_a_long_random_string
WEBHOOK_API_KEY=change_this_n8n_key
DEFAULT_COUNTRY_CODE=91

# Google Sheet sync: list your sheets in backend/sheets.config.json (copy sheets.config.example.json)
SYNC_CRON=*/5 * * * *

# AI + n8n outreach
GROQ_API_KEY=
GROQ_MODEL=llama-3.3-70b-versatile
N8N_LINKEDIN_WEBHOOK_URL=

# Private Google Sheets via service account (paste the whole downloaded JSON key on ONE line)
GOOGLE_SERVICE_ACCOUNT_JSON=
# Vercel: paste the same JSON as the sheet list instead of using sheets.config.json
SHEETS_CONFIG_JSON=
# Set to 1 on Vercel (no background cron there; n8n triggers the sync instead)
DISABLE_CRON=0

# Hosted MySQL (Aiven etc.)
DATABASE_SSL=0
DATABASE_SSL_CA=
DATABASE_CONNECTION_LIMIT=10
